    <p class="no-hint" id="noHint"></p>

    <div class="rsvp-form" id="rsvpForm">
      <label>Vos prénom(s) et nom</label>
      <input type="text" placeholder="ex. Camille &amp; Théo Dubois" />
      <label>Vous êtes là…</label>
      <div class="days-choice">
        <label><input type="radio" name="days" value="samedi" /> Samedi seulement</label>
        <label><input type="radio" name="days" value="weekend" checked /> Samedi + Dimanche</label>
