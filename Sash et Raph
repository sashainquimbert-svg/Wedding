<footer>
  <div class="footer-big">À très vite</div>
  <p>Sasha <span class="heart">♥</span> Raphaël · 29 Mai 2027 · Domaine de Puybernier</p>
</footer>

<script>
  // ---------- REVEAL ----------
  const io = new IntersectionObserver(entries => {
    entries.forEach(en => { if (en.isIntersecting) { en.target.classList.add('in'); io.unobserve(en.target); } });
  }, { threshold: 0.12 });
  document.querySelectorAll('.reveal').forEach(el => io.observe(el));

  // ---------- NAV : scroll-spy ----------
  const navLinks = document.querySelectorAll('#nav a[href^="#"]');
  const sections = [...navLinks].map(a => document.querySelector(a.getAttribute('href')));
  function spy() {
    let idx = 0;
    sections.forEach((s, i) => { if (s.getBoundingClientRect().top < 140) idx = i; });
    navLinks.forEach(l => l.classList.remove('active'));
    navLinks[idx].classList.add('active');
  }
  window.addEventListener('scroll', spy); spy();

  // ---------- COUNTDOWN ----------
  const target = new Date('2027-05-29T16:00:00+02:00').getTime();
  function tick() {
    let d = target - Date.now();
    if (d < 0) d = 0;
    document.getElementById('cd-d').textContent = Math.floor(d / 86400000);
    document.getElementById('cd-h').textContent = String(Math.floor(d / 3600000) % 24).padStart(2, '0');
    document.getElementById('cd-m').textContent = String(Math.floor(d / 60000) % 60).padStart(2, '0');
    document.getElementById('cd-s').textContent = String(Math.floor(d / 1000) % 60).padStart(2, '0');
  }
  tick(); setInterval(tick, 1000);

  // ---------- RSVP : le "Non" qui fuit (6 secondes) ----------
  const btnNo = document.getElementById('btnNo');
  const hint = document.getElementById('noHint');
  let fleeUntil = 0, fleeing = true;
  function flee() {
    if (Date.now() > fleeUntil || !fleeing) return;
    const r = document.querySelector('.choice').getBoundingClientRect();
    btnNo.style.position = 'absolute';
    btnNo.style.left = (Math.random() * (r.width - btnNo.offsetWidth) + r.left + window.scrollX) + 'px';
    btnNo.style.top = (r.top + window.scrollY - 20 - Math.random() * 160) + 'px';
    hint.textContent = ['Vous êtes sûr(e) ? 🥺', 'Vraiment sûr(e) ? 👀', 'Le dancefloor vous attend…', 'Réfléchissez encore un peu ✨'][Math.floor(Math.random()*4)];
    hint.classList.add('show');
  }
  btnNo.addEventListener('mouseenter', () => {
    if (!fleeing) return;
    if (fleeUntil === 0) {
      fleeUntil = Date.now() + 6000;
      setTimeout(() => {
        fleeing = false;
        hint.textContent = 'Bon… d’accord. Si vous êtes vraiment sûr(e), cliquez. 🤍';
      }, 6000);
    }
    flee();
  });
  btnNo.addEventListener('mousemove', flee);
  btnNo.addEventListener('click', () => {
    if (fleeing) return;
    document.getElementById('declinedMsg').classList.add('show');
    document.querySelector('.choice').style.display = 'none';
    hint.classList.remove('show');
  });
  document.getElementById('btnYes').addEventListener('click', () => {
    document.getElementById('rsvpForm').classList.add('show');
    document.querySelector('.choice').style.display = 'none';
    document.getElementById('rsvpForm').scrollIntoView({ behavior: 'smooth', block: 'center' });
  });

  // ---------- EN / FR ----------
  const FR_EN = {
    "Accueil": "Home", "Programme": "Schedule", "Venir & Dormir": "Travel & Stay",
    "Liste de Mariage": "Registry", "Nous nous marions": "We're getting married",
    "Jours": "Days", "Heures": "Hours", "Minutes": "Minutes", "Secondes": "Seconds",
    "avant le grand jour — amenez vos pas de danse": "until the big day — bring your dancing shoes",
    "Le Week-end": "The Weekend", "Samedi 29 Mai": "Saturday 29 May", "Dimanche 30 Mai": "Sunday 30 May",
    "Comment nous rejoindre": "How to reach us", "Comment venir": "Getting there", "Où dormir": "Where to stay",
    "En avion": "By plane", "En train": "By train", "En voiture": "By car",
    "À Jouques": "In Jouques", "Dans les environs": "Nearby", "Plus d'adresses": "More addresses",
    "Questions": "Questions", "Cadeaux": "Gifts",
    "Répondez avant le 1er mars 2027": "Kindly respond by 1 March 2027",
    "Oui": "Yes", "Non": "No", "Envoyer": "Send",
    "Samedi seulement": "Saturday only", "Samedi + Dimanche": "Saturday + Sunday",
    "Vous êtes là…": "You'll be there…",
    "Vos prénom(s) et nom": "Your name(s)",
    "À très vite": "See you soon"
  };
  const REV = {}; Object.entries(FR_EN).forEach(([fr, en]) => { if (!(en in REV)) REV[en] = fr; });
  let lang = 'fr';
  function walkText(node, fn) {
    if (node.nodeType === 3) { fn(node); return; }
    for (const c of node.childNodes) walkText(c, fn);
  }
  document.getElementById('langToggle').addEventListener('click', e => {
    lang = lang === 'fr' ? 'en' : 'fr';
    e.target.textContent = lang === 'fr' ? 'EN' : 'FR';
    walkText(document.body, n => {
      const t = n.nodeValue.trim();
      if (!t) return;
      const to = lang === 'en' ? FR_EN[t] : REV[t];
      if (to) n.nodeValue = n.nodeValue.replace(t, to);
    });
  });
</script>
</body>
</html>
