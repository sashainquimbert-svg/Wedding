</section>

<!-- ============ LISTE DE MARIAGE ============ -->
<section id="liste">
  <div class="wrap" style="text-align:center">
    <div class="kicker reveal" style="justify-content:center">Cadeaux</div>
    <h2 class="title reveal">Liste <span class="thin">de mariage</span></h2>
    <div class="title-rule reveal" style="justify-content:center"><span class="dot"></span></div>
    <p class="lead reveal" style="margin:0 auto">Votre présence est le plus beau des cadeaux. Mais si vous souhaitez nous gâter, une cagnotte est disponible ici :</p>
    <div class="reveal">
      <a class="cagnotte" href="#" title="Cagnotte">
        <svg width="150" height="150" viewBox="0 0 160 160" fill="none">
          <rect x="30" y="52" width="100" height="84" rx="6" stroke="#26231C" stroke-width="1.6" fill="#ECE5D3"/>
          <rect x="22" y="38" width="116" height="30" rx="6" stroke="#26231C" stroke-width="1.6" fill="#F4EFE3"/>
          <path d="M22 68 L 80 108 L 138 68" stroke="#26231C" stroke-width="1.6" fill="none"/>
          <path d="M62 46 c -10 -16 -30 -10 -26 2 c 3 9 18 14 44 6 c -26 -8 -41 -3 -44 -6 z" fill="#3E4A33"/>
          <path d="M98 46 c 10 -16 30 -10 26 2 c -3 9 -18 14 -44 6 c 26 -8 41 -3 44 -6 z" fill="#3E4A33"/>
          <path d="M80 54 v 20" stroke="#3E4A33" stroke-width="2.4" stroke-linecap="round"/>
